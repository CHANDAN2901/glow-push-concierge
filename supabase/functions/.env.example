# Tranzilla — main terminal (one-time / first charge)
TRANZILLA_MAIN_TERMINAL_NAME=glowpush1
TRANZILLA_MAIN_TERMINAL_PW=<your_main_terminal_pw>
TRANZILLA_MAIN_CREDIT_PW=<your_main_credit_pw>

# Tranzilla — token terminal (iframe + recurring charges)
TRANZILLA_TOKEN_TERMINAL_NAME=glowpush1tok
TRANZILLA_TOKEN_TERMINAL_PW=<your_token_terminal_pw>
TRANZILLA_TOKEN_CREDIT_PW=<your_token_credit_pw>

# Tranzilla API keys (shared across both terminals)
TRANZILLA_PUBLIC_API_KEY=<your_public_api_key>
TRANZILLA_PRIVATE_API_KEY=<your_private_api_key>

# App base URL (used for redirect after payment)
APP_URL=https://app.glowpush.co.il
